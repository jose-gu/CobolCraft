IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocksCount-TC-2.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO DYNAMIC WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-COUNT                 BINARY-LONG UNSIGNED.
    01 LK-COUNT_DISPLAY         PIC 9(10).
    01 OUTPUT-LINE              PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH      PIC X(256).

PROCEDURE DIVISION.
    DISPLAY "Main-Blocks-Count started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    *> Initialize BLOCKS structure as empty
    MOVE 0 TO BLOCK-COUNT.

    *> Call the subprogram under test
    CALL 'Blocks-Count' USING LK-COUNT.
    DISPLAY "Blocks-Count returned LK-COUNT=" LK-COUNT.

    *> Write outputs to result file
    OPEN OUTPUT RESULT-FILE.
    MOVE LK-COUNT TO LK-COUNT_DISPLAY.
    STRING "LK-COUNT=" DELIMITED BY SIZE
           LK-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.
    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocksCount-TC-2.

