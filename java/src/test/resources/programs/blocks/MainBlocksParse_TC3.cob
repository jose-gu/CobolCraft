IDENTIFICATION DIVISION.
PROGRAM-ID. Main-BlocksParse-TC3.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    01 LK-JSON PIC X(63) VALUE SPACES.
    01 LK-JSON-LEN BINARY-LONG UNSIGNED.
    01 LK-FAILURE BINARY-CHAR UNSIGNED.
    01 BLOCK-COUNT BINARY-LONG UNSIGNED.
    01 BLOCK-ENTRY-NAME PIC X(64) OCCURS 100 TIMES.
    01 BLOCK-ENTRY-TYPE PIC X(64) OCCURS 100 TIMES.
    01 BLOCK-ENTRY-PROPERTY-COUNT BINARY-LONG UNSIGNED OCCURS 100 TIMES.
    01 BLOCK-ENTRY-MINIMUM-STATE-ID BINARY-LONG UNSIGNED OCCURS 100 TIMES.
    01 BLOCK-ENTRY-MAXIMUM-STATE-ID BINARY-LONG UNSIGNED OCCURS 100 TIMES.
    01 BLOCK-ENTRY-DEFAULT-STATE-ID BINARY-LONG UNSIGNED OCCURS 100 TIMES.
    01 BLOCKS-MAXIMUM-STATE-ID BINARY-LONG UNSIGNED.
    01 OUTPUT-LINE PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH PIC X(100).

PROCEDURE DIVISION.
    DISPLAY "Main-BlocksParse started".

    *> Accept result file path from environment
    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH"

    *> Accept inputs dynamically from environment
    ACCEPT LK-JSON FROM ENVIRONMENT "LK-JSON"
    ACCEPT LK-JSON-LEN FROM ENVIRONMENT "LK-JSON-LEN"
    ACCEPT LK-FAILURE FROM ENVIRONMENT "LK-FAILURE"

    *> Call the subprogram
    CALL 'Blocks-Parse' USING LK-JSON LK-JSON-LEN LK-FAILURE
    DISPLAY "Blocks-Parse returned LK-FAILURE=" LK-FAILURE

    *> Write outputs to file
    OPEN OUTPUT RESULT-FILE
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           LK-FAILURE DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-NAME(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-TYPE(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-TYPE(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-PROPERTY-COUNT(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-COUNT(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-MINIMUM-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MINIMUM-STATE-ID(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MAXIMUM-STATE-ID(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCK-ENTRY-DEFAULT-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-DEFAULT-STATE-ID(1) DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    STRING "BLOCKS-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           BLOCKS-MAXIMUM-STATE-ID DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE

    GOBACK.
END PROGRAM Main-BlocksParse-TC3.

