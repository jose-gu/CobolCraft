IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocks-Parse_TC-7.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.

    01 LK-JSON                PIC X(4096) VALUE SPACES.
    01 LK-JSON-LEN            BINARY-LONG UNSIGNED VALUE 0.
    01 LK-FAILURE             BINARY-CHAR UNSIGNED VALUE 0.

    01 CHECK-NAME-OK          BINARY-CHAR UNSIGNED VALUE 0.
    01 EXPECTED-NAME          PIC X(64) VALUE "minecraft:toomany".

    01 WS-RESULT-FILE-PATH    PIC X(200) VALUE SPACES.
    01 OUTPUT-LINE            PIC X(80) VALUE SPACES.
    01 NUM-DISPLAY            PIC 9(10) VALUE 0.

    01 PROP-COUNT-1           BINARY-LONG UNSIGNED VALUE 0.

PROCEDURE DIVISION.
    DISPLAY "Main-Blocks-Parse started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    ACCEPT LK-JSON FROM ENVIRONMENT "LK-JSON".
    ACCEPT LK-JSON-LEN FROM ENVIRONMENT "LK-JSON-LEN".
    ACCEPT LK-FAILURE FROM ENVIRONMENT "LK-FAILURE".

    CALL "Blocks-Parse" USING LK-JSON LK-JSON-LEN LK-FAILURE.

    IF BLOCK-ENTRY-NAME(1) = EXPECTED-NAME
        MOVE 1 TO CHECK-NAME-OK
    ELSE
        MOVE 0 TO CHECK-NAME-OK
    END-IF.

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO PROP-COUNT-1.

    OPEN OUTPUT RESULT-FILE.

    *> LK-FAILURE
    MOVE LK-FAILURE TO NUM-DISPLAY.
    MOVE SPACES TO OUTPUT-LINE.
    STRING
        "LK-FAILURE=" DELIMITED BY SIZE
        NUM-DISPLAY   DELIMITED BY SIZE
        INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-COUNT
    MOVE BLOCK-COUNT TO NUM-DISPLAY.
    MOVE SPACES TO OUTPUT-LINE.
    STRING
        "BLOCK-COUNT=" DELIMITED BY SIZE
        NUM-DISPLAY    DELIMITED BY SIZE
        INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> CHECK-NAME-OK
    MOVE CHECK-NAME-OK TO NUM-DISPLAY.
    MOVE SPACES TO OUTPUT-LINE.
    STRING
        "CHECK-NAME-OK=" DELIMITED BY SIZE
        NUM-DISPLAY     DELIMITED BY SIZE
        INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-COUNT-1
    MOVE PROP-COUNT-1 TO NUM-DISPLAY.
    MOVE SPACES TO OUTPUT-LINE.
    STRING
        "BLOCK-ENTRY-PROPERTY-COUNT-1=" DELIMITED BY SIZE
        NUM-DISPLAY                     DELIMITED BY SIZE
        INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocks-Parse_TC-7.

