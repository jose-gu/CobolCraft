IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocksParse_TC-4.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(256).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-JSON            PIC X(512) VALUE SPACES.
    01 LK-JSON-LEN        BINARY-LONG UNSIGNED VALUE 0.
    01 LK-FAILURE         BINARY-CHAR UNSIGNED VALUE 0.

    01 LK-FAILURE-DISPLAY PIC 9(10) VALUE 0.
    01 BLOCK-COUNT-DISPLAY PIC 9(10) VALUE 0.
    01 OUTPUT-LINE        PIC X(256) VALUE SPACES.
    01 WS-RESULT-FILE-PATH PIC X(200) VALUE SPACES.

PROCEDURE DIVISION.
    DISPLAY "Main-Blocks-Parse started".

    *> Accept result file path from environment
    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    *> Accept inputs
    ACCEPT LK-JSON      FROM ENVIRONMENT "LK-JSON".
    ACCEPT LK-JSON-LEN  FROM ENVIRONMENT "LK-JSON-LEN".
    ACCEPT LK-FAILURE   FROM ENVIRONMENT "LK-FAILURE".

    *> Call the subprogram under test
    CALL "Blocks-Parse" USING LK-JSON LK-JSON-LEN LK-FAILURE.

    *> Write outputs to result file
    OPEN OUTPUT RESULT-FILE

    MOVE LK-FAILURE TO LK-FAILURE-DISPLAY
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           LK-FAILURE-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    *> Additionally write BLOCK-COUNT for inspection (not required by assertions)
    MOVE SPACES TO OUTPUT-LINE
    MOVE BLOCK-COUNT TO BLOCK-COUNT-DISPLAY
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE
    GOBACK.
END PROGRAM MainBlocksParse_TC-4.

