IDENTIFICATION DIVISION.
PROGRAM-ID. Main-BlocksParseExceedMaximumProperties-TC7.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-JSON PIC X(316) VALUE SPACES.
    01 LK-JSON-LEN BINARY-LONG UNSIGNED VALUE 316.
    01 LK-FAILURE BINARY-CHAR UNSIGNED VALUE 0.
    01 BLOCK-COUNT DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-NAME-1 DISPLAY PIC X(64).
    01 BLOCK-ENTRY-PROPERTY-COUNT-1 DISPLAY PIC 9(10).
    01 OUTPUT-LINE PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH PIC X(100).

PROCEDURE DIVISION.
    DISPLAY "Main-BlocksParseExceedMaximumProperties started".

    *> Accept result file path from environment
    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH"

    *> Accept inputs dynamically from environment
    ACCEPT LK-JSON FROM ENVIRONMENT "LK-JSON"

    *> Call the subprogram
    CALL 'Blocks-Parse' USING LK-JSON LK-JSON-LEN LK-FAILURE
    DISPLAY "Blocks-Parse returned LK-FAILURE=" LK-FAILURE

    *> Write outputs to file
    OPEN OUTPUT RESULT-FILE
    MOVE LK-FAILURE TO BLOCK-COUNT
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           BLOCK-COUNT DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-COUNT TO BLOCK-ENTRY-NAME-1
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME-1 DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-NAME(1) TO BLOCK-ENTRY-NAME-1
    STRING "BLOCK-ENTRY-NAME(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME-1 DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO BLOCK-ENTRY-PROPERTY-COUNT-1
    STRING "BLOCK-ENTRY-PROPERTY-COUNT(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-COUNT-1 DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE

    GOBACK.
END PROGRAM Main-BlocksParseExceedMaximumProperties-TC7.

