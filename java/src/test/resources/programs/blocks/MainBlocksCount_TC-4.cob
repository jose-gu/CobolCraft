IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocksCount_TC-4.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-COUNT                 BINARY-LONG UNSIGNED.
    01 LK-COUNT-DISPLAY         PIC 9(10).
    01 OUTPUT-LINE              PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH      PIC X(200).
    01 INITIAL-BLOCK-COUNT      BINARY-LONG UNSIGNED VALUE 0.
    01 ADD-BLOCKS               BINARY-LONG UNSIGNED VALUE 0.

PROCEDURE DIVISION.
    DISPLAY "MainBlocksCount_TC-4 started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    ACCEPT BLOCK-COUNT FROM ENVIRONMENT "BLOCK-COUNT".
    ACCEPT INITIAL-BLOCK-COUNT FROM ENVIRONMENT "INITIAL-BLOCK-COUNT".
    ACCEPT ADD-BLOCKS FROM ENVIRONMENT "ADD-BLOCKS".

    IF BLOCK-COUNT = 0
        MOVE INITIAL-BLOCK-COUNT TO BLOCK-COUNT
        ADD ADD-BLOCKS TO BLOCK-COUNT
    END-IF.

    CALL 'Blocks-Count' USING LK-COUNT.
    DISPLAY "Blocks-Count returned LK-COUNT=" LK-COUNT.

    OPEN OUTPUT RESULT-FILE.
    MOVE LK-COUNT TO LK-COUNT-DISPLAY.
    STRING "LK-COUNT=" DELIMITED BY SIZE
           LK-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.
    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocksCount_TC-4.

