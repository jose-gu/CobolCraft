IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocks-Parse_TC-8.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 WS-RESULT-FILE-PATH        PIC X(200).
    01 OUTPUT-LINE                PIC X(80) VALUE SPACES.

    01 WS-JSON                    PIC X(600000).
    01 LK-JSON-LEN                BINARY-LONG UNSIGNED.
    01 LK-FAILURE                 BINARY-CHAR UNSIGNED VALUE 0.

    01 WS-PTR                     BINARY-LONG UNSIGNED VALUE 1.
    01 I                          BINARY-LONG UNSIGNED.
    01 I-DIGITS-KEY               PIC 9(10).
    01 I-EDIT                     PIC Z(9)9.

    01 LK-FAILURE_DISPLAY         PIC 9(10).
    01 BLOCK-COUNT_DISPLAY        PIC 9(10).
    01 BLOCKS-CAPACITY-DISPLAY    PIC 9(10).

PROCEDURE DIVISION.
    DISPLAY "MainBlocks-Parse_TC-8 started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    *> Build JSON with BLOCKS-CAPACITY blocks: {"b0000000001":{"states":[{"id":1}]}, ... }
    MOVE 1 TO WS-PTR.
    STRING "{" DELIMITED BY SIZE INTO WS-JSON WITH POINTER WS-PTR.

    PERFORM VARYING I FROM 1 BY 1 UNTIL I > BLOCKS-CAPACITY
        IF I > 1
            STRING "," DELIMITED BY SIZE INTO WS-JSON WITH POINTER WS-PTR
        END-IF

        MOVE I TO I-DIGITS-KEY
        MOVE I TO I-EDIT

        STRING
            '"'            DELIMITED BY SIZE
            "b"            DELIMITED BY SIZE
            I-DIGITS-KEY   DELIMITED BY SIZE
            '"'            DELIMITED BY SIZE
            ":"            DELIMITED BY SIZE
            "{"            DELIMITED BY SIZE
            '"states":[{"' DELIMITED BY SIZE
            '"id":'        DELIMITED BY SIZE
            FUNCTION TRIM(I-EDIT) DELIMITED BY SIZE
            '}]}'          DELIMITED BY SIZE
            INTO WS-JSON WITH POINTER WS-PTR
        END-STRING
    END-PERFORM

    STRING "}" DELIMITED BY SIZE INTO WS-JSON WITH POINTER WS-PTR.

    COMPUTE LK-JSON-LEN = WS-PTR - 1.

    *> Call the target program
    CALL "Blocks-Parse" USING WS-JSON LK-JSON-LEN LK-FAILURE.

    *> Write outputs
    OPEN OUTPUT RESULT-FILE.

    MOVE LK-FAILURE TO LK-FAILURE_DISPLAY.
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           LK-FAILURE_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCK-COUNT TO BLOCK-COUNT_DISPLAY.
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCKS-CAPACITY TO BLOCKS-CAPACITY-DISPLAY.
    STRING "BLOCKS-CAPACITY=" DELIMITED BY SIZE
           BLOCKS-CAPACITY-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocks-Parse_TC-8.

