IDENTIFICATION DIVISION.
PROGRAM-ID. Main-BlocksParse-TC1.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-JSON                  PIC X(130).
    01 LK-JSON-LEN              BINARY-LONG UNSIGNED.
    01 LK-FAILURE               BINARY-CHAR UNSIGNED.
    01 BLOCK-COUNT_DISPLAY      PIC 9(10).
    01 BLOCK-ENTRY-NAME_DISPLAY PIC X(64).
    01 BLOCK-ENTRY-TYPE_DISPLAY PIC X(10).
    01 BLOCK-ENTRY-PROPERTY-COUNT_DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-PROPERTY-NAME_DISPLAY PIC X(32).
    01 BLOCK-ENTRY-PROPERTY-VALUE-COUNT_DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-PROPERTY-VALUE_DISPLAY PIC X(32).
    01 BLOCK-ENTRY-MINIMUM-STATE-ID_DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-MAXIMUM-STATE-ID_DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-DEFAULT-STATE-ID_DISPLAY PIC 9(10).
    01 BLOCKS-MAXIMUM-STATE-ID_DISPLAY PIC 9(10).
    01 BLOCK-NAMES-ENTRY-NAME_DISPLAY PIC X(64).
    01 BLOCK-NAMES-ENTRY-INDEX_DISPLAY PIC 9(10).
    01 OUTPUT-LINE PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH PIC X(100).

PROCEDURE DIVISION.
    DISPLAY "Main-BlocksParse started".

    *> Accept result file path from environment
    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH"

    *> Accept inputs dynamically from environment
    ACCEPT LK-JSON FROM ENVIRONMENT "LK-JSON"
    ACCEPT LK-JSON-LEN FROM ENVIRONMENT "LK-JSON-LEN"
    ACCEPT LK-FAILURE FROM ENVIRONMENT "LK-FAILURE"

    *> Call the subprogram
    CALL 'Blocks-Parse' USING LK-JSON LK-JSON-LEN LK-FAILURE
    DISPLAY "Blocks-Parse returned LK-FAILURE=" LK-FAILURE

    *> Write outputs to file
    OPEN OUTPUT RESULT-FILE
    MOVE BLOCK-COUNT TO BLOCK-COUNT_DISPLAY
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-NAME(1) TO BLOCK-ENTRY-NAME_DISPLAY
    STRING "BLOCK-ENTRY-NAME(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-TYPE(1) TO BLOCK-ENTRY-TYPE_DISPLAY
    STRING "BLOCK-ENTRY-TYPE(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-TYPE_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO BLOCK-ENTRY-PROPERTY-COUNT_DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-COUNT(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-NAME(1, 1) TO BLOCK-ENTRY-PROPERTY-NAME_DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-NAME(1, 1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-NAME_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-VALUE-COUNT(1, 1) TO BLOCK-ENTRY-PROPERTY-VALUE-COUNT_DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-VALUE-COUNT(1, 1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-VALUE-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-VALUE(1, 1, 1) TO BLOCK-ENTRY-PROPERTY-VALUE_DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-VALUE(1, 1, 1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-VALUE_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-VALUE(1, 1, 2) TO BLOCK-ENTRY-PROPERTY-VALUE_DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-VALUE(1, 1, 2)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-VALUE_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-MINIMUM-STATE-ID(1) TO BLOCK-ENTRY-MINIMUM-STATE-ID_DISPLAY
    STRING "BLOCK-ENTRY-MINIMUM-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MINIMUM-STATE-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-MAXIMUM-STATE-ID(1) TO BLOCK-ENTRY-MAXIMUM-STATE-ID_DISPLAY
    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MAXIMUM-STATE-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-DEFAULT-STATE-ID(1) TO BLOCK-ENTRY-DEFAULT-STATE-ID_DISPLAY
    STRING "BLOCK-ENTRY-DEFAULT-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-DEFAULT-STATE-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCKS-MAXIMUM-STATE-ID TO BLOCKS-MAXIMUM-STATE-ID_DISPLAY
    STRING "BLOCKS-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           BLOCKS-MAXIMUM-STATE-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-NAMES-ENTRY-NAME(1) TO BLOCK-NAMES-ENTRY-NAME_DISPLAY
    STRING "BLOCK-NAMES-ENTRY-NAME(1)=" DELIMITED BY SIZE
           BLOCK-NAMES-ENTRY-NAME_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-NAMES-ENTRY-INDEX(1) TO BLOCK-NAMES-ENTRY-INDEX_DISPLAY
    STRING "BLOCK-NAMES-ENTRY-INDEX(1)=" DELIMITED BY SIZE
           BLOCK-NAMES-ENTRY-INDEX_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE

    GOBACK.
END PROGRAM Main-BlocksParse-TC1.

