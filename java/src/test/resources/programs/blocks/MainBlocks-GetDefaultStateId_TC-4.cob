IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocks-GetDefaultStateId_TC-4.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 ENV-LK-BLOCK-ID        PIC 9(10) VALUE ZEROES.
    01 LK-BLOCK-ID            BINARY-LONG VALUE 0.
    01 LK-STATE-ID            BINARY-LONG VALUE 0.
    01 LK-STATE-ID_DISPLAY    PIC 9(10) VALUE ZEROES.
    01 OUTPUT-LINE            PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH    PIC X(100) VALUE SPACES.
    01 WS-DEFAULT-STATE-ID    PIC 9(10) VALUE 5.

PROCEDURE DIVISION.
    DISPLAY "Main-Blocks-GetDefaultStateId started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".
    ACCEPT ENV-LK-BLOCK-ID FROM ENVIRONMENT "LK-BLOCK-ID".
    MOVE ENV-LK-BLOCK-ID TO LK-BLOCK-ID.

    *> Initialize the BLOCKS structure for the specified block as single-state (default only needed here)
    MOVE WS-DEFAULT-STATE-ID TO BLOCK-ENTRY-DEFAULT-STATE-ID(LK-BLOCK-ID + 1).

    *> Call the subprogram under test
    CALL 'Blocks-GetDefaultStateId' USING LK-BLOCK-ID LK-STATE-ID.
    DISPLAY "Blocks-GetDefaultStateId returned LK-STATE-ID=" LK-STATE-ID.

    *> Write result
    OPEN OUTPUT RESULT-FILE.
    MOVE LK-STATE-ID TO LK-STATE-ID_DISPLAY.
    STRING "LK-STATE-ID=" DELIMITED BY SIZE
           LK-STATE-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.
    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocks-GetDefaultStateId_TC-4.

