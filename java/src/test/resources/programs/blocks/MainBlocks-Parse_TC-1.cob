IDENTIFICATION DIVISION.
PROGRAM-ID. Main-Blocks-Parse-TC-1.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.

    01 LK-JSON              PIC X(512).
    01 LK-JSON-LEN          BINARY-LONG UNSIGNED VALUE 0.
    01 LK-FAILURE           BINARY-CHAR UNSIGNED VALUE 0.

    01 OUTPUT-LINE          PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH  PIC X(200).

    77 DISP-NUM             PIC 9(18) VALUE 0.
    77 HASH-VALUE           BINARY-LONG UNSIGNED VALUE 0.
    77 TRIM-LEN             BINARY-LONG UNSIGNED VALUE 0.
    77 IDX                  BINARY-LONG UNSIGNED VALUE 0.
    01 WORK-TEXT            PIC X(64).

PROCEDURE DIVISION.
    DISPLAY "Main-Blocks-Parse started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".
    ACCEPT LK-JSON        FROM ENVIRONMENT "LK-JSON".
    ACCEPT LK-JSON-LEN    FROM ENVIRONMENT "LK-JSON-LEN".
    ACCEPT LK-FAILURE     FROM ENVIRONMENT "LK-FAILURE".

    CALL "Blocks-Parse" USING LK-JSON LK-JSON-LEN LK-FAILURE.

    OPEN OUTPUT RESULT-FILE.

    *> LK-FAILURE
    MOVE LK-FAILURE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           DISP-NUM      DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-COUNT
    MOVE BLOCK-COUNT TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           DISP-NUM       DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-NAME(1) HASH
    MOVE BLOCK-ENTRY-NAME(1) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-NAME-1-HASH=" DELIMITED BY SIZE
           DISP-NUM                   DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-TYPE(1) HASH
    MOVE SPACES TO WORK-TEXT.
    MOVE BLOCK-ENTRY-TYPE(1) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-TYPE-1-HASH=" DELIMITED BY SIZE
           DISP-NUM                   DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-COUNT(1)
    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-PROPERTY-COUNT-1=" DELIMITED BY SIZE
           DISP-NUM                        DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-NAME(1,1) HASH
    MOVE SPACES TO WORK-TEXT.
    MOVE BLOCK-ENTRY-PROPERTY-NAME(1,1) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-PROPERTY-NAME-1-1-HASH=" DELIMITED BY SIZE
           DISP-NUM                            DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-VALUE-COUNT(1,1)
    MOVE BLOCK-ENTRY-PROPERTY-VALUE-COUNT(1,1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-PROPERTY-VALUE-COUNT-1-1=" DELIMITED BY SIZE
           DISP-NUM                               DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-VALUE(1,1,1) HASH
    MOVE SPACES TO WORK-TEXT.
    MOVE BLOCK-ENTRY-PROPERTY-VALUE(1,1,1) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-PROPERTY-VALUE-1-1-1-HASH=" DELIMITED BY SIZE
           DISP-NUM                               DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-ENTRY-PROPERTY-VALUE(1,1,2) HASH
    MOVE SPACES TO WORK-TEXT.
    MOVE BLOCK-ENTRY-PROPERTY-VALUE(1,1,2) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-PROPERTY-VALUE-1-1-2-HASH=" DELIMITED BY SIZE
           DISP-NUM                               DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> STATE IDS
    MOVE BLOCK-ENTRY-MINIMUM-STATE-ID(1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-MINIMUM-STATE-ID-1=" DELIMITED BY SIZE
           DISP-NUM                         DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-MAXIMUM-STATE-ID(1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID-1=" DELIMITED BY SIZE
           DISP-NUM                         DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-DEFAULT-STATE-ID(1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-ENTRY-DEFAULT-STATE-ID-1=" DELIMITED BY SIZE
           DISP-NUM                         DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCKS-MAXIMUM-STATE-ID TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCKS-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           DISP-NUM                   DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    *> BLOCK-NAMES first entry
    MOVE SPACES TO WORK-TEXT.
    MOVE BLOCK-NAMES-ENTRY-NAME(1) TO WORK-TEXT.
    PERFORM COMPUTE-HASH-WORK-TEXT.
    MOVE HASH-VALUE TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-NAMES-ENTRY-NAME-1-HASH=" DELIMITED BY SIZE
           DISP-NUM                        DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    MOVE BLOCK-NAMES-ENTRY-INDEX(1) TO DISP-NUM.
    MOVE SPACES TO OUTPUT-LINE.
    STRING "BLOCK-NAMES-ENTRY-INDEX-1=" DELIMITED BY SIZE
           DISP-NUM                     DELIMITED BY SIZE
      INTO OUTPUT-LINE
    END-STRING.
    MOVE OUTPUT-LINE TO RESULT-REC.
    WRITE RESULT-REC.

    CLOSE RESULT-FILE.
    GOBACK.

COMPUTE-HASH-WORK-TEXT.
    MOVE 0 TO HASH-VALUE.
    MOVE 64 TO TRIM-LEN.
    PERFORM VARYING IDX FROM 64 BY -1 UNTIL IDX < 1
        IF WORK-TEXT(IDX:1) NOT = SPACE
            MOVE IDX TO TRIM-LEN
            EXIT PERFORM
        END-IF
    END-PERFORM.
    IF TRIM-LEN = 64
        CONTINUE
    END-IF.
    PERFORM VARYING IDX FROM 1 BY 1 UNTIL IDX > TRIM-LEN
        COMPUTE HASH-VALUE = HASH-VALUE + FUNCTION ORD(WORK-TEXT(IDX:1))
    END-PERFORM.
    EXIT.

END PROGRAM Main-Blocks-Parse-TC-1.

