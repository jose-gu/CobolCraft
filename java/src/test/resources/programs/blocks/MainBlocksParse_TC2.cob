IDENTIFICATION DIVISION.
PROGRAM-ID. Main-BlocksParse-TC2.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-JSON                  PIC X(268) VALUE SPACES.
    01 LK-JSON-LEN              BINARY-LONG UNSIGNED VALUE 268.
    01 LK-FAILURE               BINARY-CHAR UNSIGNED VALUE 0.
    01 BLOCK-COUNT_DISPLAY      PIC 9(10).
    01 BLOCK-ENTRY-NAME-DISPLAY PIC X(64).
    01 BLOCK-ENTRY-PROPERTY-COUNT-DISPLAY PIC 9(10).
    01 BLOCK-ENTRY-MAXIMUM-STATE-ID-DISPLAY PIC 9(10).
    01 BLOCKS-MAXIMUM-STATE-ID-DISPLAY PIC 9(10).
    01 OUTPUT-LINE              PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH      PIC X(100).

PROCEDURE DIVISION.
    DISPLAY "Main-BlocksParse started".

    *> Accept result file path from environment
    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH"

    *> Accept inputs dynamically from environment
    ACCEPT LK-JSON FROM ENVIRONMENT "LK-JSON"

    *> Call the subprogram
    CALL 'Blocks-Parse' USING LK-JSON LK-JSON-LEN LK-FAILURE
    DISPLAY "Blocks-Parse returned LK-FAILURE=" LK-FAILURE

    *> Write outputs to file
    OPEN OUTPUT RESULT-FILE
    MOVE LK-FAILURE TO BLOCK-COUNT_DISPLAY
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           BLOCK-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-COUNT TO BLOCK-COUNT_DISPLAY
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-NAME(1) TO BLOCK-ENTRY-NAME-DISPLAY
    STRING "BLOCK-ENTRY-NAME(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-NAME(2) TO BLOCK-ENTRY-NAME-DISPLAY
    STRING "BLOCK-ENTRY-NAME(2)=" DELIMITED BY SIZE
           BLOCK-ENTRY-NAME-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO BLOCK-ENTRY-PROPERTY-COUNT-DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-COUNT(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(2) TO BLOCK-ENTRY-PROPERTY-COUNT-DISPLAY
    STRING "BLOCK-ENTRY-PROPERTY-COUNT(2)=" DELIMITED BY SIZE
           BLOCK-ENTRY-PROPERTY-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-MAXIMUM-STATE-ID(1) TO BLOCK-ENTRY-MAXIMUM-STATE-ID-DISPLAY
    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID(1)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MAXIMUM-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCK-ENTRY-MAXIMUM-STATE-ID(2) TO BLOCK-ENTRY-MAXIMUM-STATE-ID-DISPLAY
    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID(2)=" DELIMITED BY SIZE
           BLOCK-ENTRY-MAXIMUM-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE BLOCKS-MAXIMUM-STATE-ID TO BLOCKS-MAXIMUM-STATE-ID-DISPLAY
    STRING "BLOCKS-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           BLOCKS-MAXIMUM-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE

    GOBACK.
END PROGRAM Main-BlocksParse-TC2.

