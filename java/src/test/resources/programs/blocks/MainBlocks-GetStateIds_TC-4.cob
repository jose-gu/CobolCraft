IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocks-GetStateIds_TC-4.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.
    01 LK-BLOCK-ID            BINARY-LONG.
    01 LK-MINIMUM-ID          BINARY-LONG.
    01 LK-MAXIMUM-ID          BINARY-LONG.
    01 LK-MINIMUM-ID_DISPLAY  PIC 9(10).
    01 LK-MAXIMUM-ID_DISPLAY  PIC 9(10).
    01 OUTPUT-LINE            PIC X(80) VALUE SPACES.
    01 WS-RESULT-FILE-PATH    PIC X(100).
    01 WS-INDEX               BINARY-LONG.
    01 WS-SINGLE-STATE-ID     BINARY-LONG VALUE 777.

PROCEDURE DIVISION.
    DISPLAY "MainBlocks-GetStateIds_TC-4 started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    *> Input parameter
    ACCEPT LK-BLOCK-ID FROM ENVIRONMENT "LK-BLOCK-ID".

    *> Initialize shared BLOCKS structure for the selected block
    COMPUTE WS-INDEX = LK-BLOCK-ID + 1
    MOVE WS-SINGLE-STATE-ID TO BLOCK-ENTRY-MINIMUM-STATE-ID(WS-INDEX)
    MOVE WS-SINGLE-STATE-ID TO BLOCK-ENTRY-MAXIMUM-STATE-ID(WS-INDEX)

    *> Call the subprogram
    CALL 'Blocks-GetStateIds' USING LK-BLOCK-ID LK-MINIMUM-ID LK-MAXIMUM-ID
    DISPLAY "Blocks-GetStateIds returned " LK-MINIMUM-ID " " LK-MAXIMUM-ID

    *> Write outputs
    OPEN OUTPUT RESULT-FILE

    MOVE SPACES TO OUTPUT-LINE
    MOVE LK-MINIMUM-ID TO LK-MINIMUM-ID_DISPLAY
    STRING "LK-MINIMUM-ID=" DELIMITED BY SIZE
           LK-MINIMUM-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    MOVE SPACES TO OUTPUT-LINE
    MOVE LK-MAXIMUM-ID TO LK-MAXIMUM-ID_DISPLAY
    STRING "LK-MAXIMUM-ID=" DELIMITED BY SIZE
           LK-MAXIMUM-ID_DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC

    CLOSE RESULT-FILE
    GOBACK.
END PROGRAM MainBlocks-GetStateIds_TC-4.

