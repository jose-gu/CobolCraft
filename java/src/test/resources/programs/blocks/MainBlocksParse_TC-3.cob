IDENTIFICATION DIVISION.
PROGRAM-ID. MainBlocksParse_TC-3.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT RESULT-FILE ASSIGN TO WS-RESULT-FILE-PATH
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD RESULT-FILE.
01 RESULT-REC PIC X(80).

WORKING-STORAGE SECTION.
    COPY DD-BLOCKS.

    01 LK-JSON                 PIC X(512).
    01 LK-JSON-LEN             BINARY-LONG UNSIGNED.
    01 LK-FAILURE              BINARY-CHAR UNSIGNED.

    01 NAME-IS-AIR             BINARY-CHAR UNSIGNED VALUE 0.
    01 TYPE-IS-SPACES          BINARY-CHAR UNSIGNED VALUE 0.

    01 WS-RESULT-FILE-PATH     PIC X(200).
    01 OUTPUT-LINE             PIC X(80) VALUE SPACES.

    01 LK-FAILURE-DISPLAY                  PIC 9(10).
    01 BLOCK-COUNT-DISPLAY                 PIC 9(10).
    01 NAME-IS-AIR-DISPLAY                 PIC 9(10).
    01 TYPE-IS-SPACES-DISPLAY              PIC 9(10).
    01 PROPERTY-COUNT-DISPLAY              PIC 9(10).
    01 MIN-STATE-ID-DISPLAY                PIC 9(10).
    01 MAX-STATE-ID-DISPLAY                PIC 9(10).
    01 DEFAULT-STATE-ID-DISPLAY            PIC 9(10).
    01 BLOCKS-MAX-STATE-ID-DISPLAY         PIC 9(10).

PROCEDURE DIVISION.
    DISPLAY "Main-BlocksParse_TC-3 started".

    ACCEPT WS-RESULT-FILE-PATH FROM ENVIRONMENT "RESULT_FILE_PATH".

    ACCEPT LK-JSON       FROM ENVIRONMENT "LK-JSON".
    ACCEPT LK-JSON-LEN   FROM ENVIRONMENT "LK-JSON-LEN".
    ACCEPT LK-FAILURE    FROM ENVIRONMENT "LK-FAILURE".

    CALL "Blocks-Parse" USING LK-JSON LK-JSON-LEN LK-FAILURE.

    *> Compute verification flags based on populated BLOCKS structure
    IF BLOCK-ENTRY-NAME(1) = "minecraft:air"
        MOVE 1 TO NAME-IS-AIR
    ELSE
        MOVE 0 TO NAME-IS-AIR
    END-IF.

    IF BLOCK-ENTRY-TYPE(1) = SPACES
        MOVE 1 TO TYPE-IS-SPACES
    ELSE
        MOVE 0 TO TYPE-IS-SPACES
    END-IF.

    *> Write outputs
    OPEN OUTPUT RESULT-FILE.

    MOVE LK-FAILURE TO LK-FAILURE-DISPLAY.
    STRING "LK-FAILURE=" DELIMITED BY SIZE
           LK-FAILURE-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCK-COUNT TO BLOCK-COUNT-DISPLAY.
    STRING "BLOCK-COUNT=" DELIMITED BY SIZE
           BLOCK-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE NAME-IS-AIR TO NAME-IS-AIR-DISPLAY.
    STRING "BLOCK-ENTRY-NAME-IS-AIR=" DELIMITED BY SIZE
           NAME-IS-AIR-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE TYPE-IS-SPACES TO TYPE-IS-SPACES-DISPLAY.
    STRING "BLOCK-ENTRY-TYPE-IS-SPACES=" DELIMITED BY SIZE
           TYPE-IS-SPACES-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-PROPERTY-COUNT(1) TO PROPERTY-COUNT-DISPLAY.
    STRING "BLOCK-ENTRY-PROPERTY-COUNT=" DELIMITED BY SIZE
           PROPERTY-COUNT-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-MINIMUM-STATE-ID(1) TO MIN-STATE-ID-DISPLAY.
    STRING "BLOCK-ENTRY-MINIMUM-STATE-ID=" DELIMITED BY SIZE
           MIN-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-MAXIMUM-STATE-ID(1) TO MAX-STATE-ID-DISPLAY.
    STRING "BLOCK-ENTRY-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           MAX-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCK-ENTRY-DEFAULT-STATE-ID(1) TO DEFAULT-STATE-ID-DISPLAY.
    STRING "BLOCK-ENTRY-DEFAULT-STATE-ID=" DELIMITED BY SIZE
           DEFAULT-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    MOVE BLOCKS-MAXIMUM-STATE-ID TO BLOCKS-MAX-STATE-ID-DISPLAY.
    STRING "BLOCKS-MAXIMUM-STATE-ID=" DELIMITED BY SIZE
           BLOCKS-MAX-STATE-ID-DISPLAY DELIMITED BY SIZE
           INTO OUTPUT-LINE
    END-STRING
    MOVE OUTPUT-LINE TO RESULT-REC
    WRITE RESULT-REC.

    CLOSE RESULT-FILE.

    GOBACK.
END PROGRAM MainBlocksParse_TC-3.

